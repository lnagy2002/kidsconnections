{
  "mode": "live-paper",
  "reportsDir": "reports-trend-live-oportunistic",
  "backend": { "type": "alpaca" },
  "alpacaFeed": "iex",

  "timeframe": "1d",
  "lookback": 1500,

  "startEquity": 20000,
  "riskPerTradePct": 0.6,
  "maxPositionNotionalUSD": 15000,
  "feesPctRoundtrip": 0.04,
  "slippageBps": 1,

  "strategy": { "style": "auto" },
  "auto": { "enabled": true, "prefer": "trend", "fallback": "meanReversion" },

  "emaFast": 50,
  "emaSlow": 200,
  "rsiPeriod": 14,
  "atrPeriod": 21,

  "rsiLong": 48,
  "rsiLongSoft": 46,
  "useLtfEmaSlope": false,
  "entryAtrCushion": 0.10,

  "atrStopMult": 2.0,
  "trailingStop": { "enabled": true, "mode": "entryATR", "atrMult": 2.2, "onCloseOnly": false },
  "trailStartR": 1.1,
  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 0.8 },

  "volFilter": { "enabled": true, "atrPctMin": 0.25, "atrPctMax": 6.0 },

  "timeStop": { "enabled": true, "bars": 12 },

  "partialTake": { "enabled": true, "atR": 1.0, "closeFrac": 0.5, "moveStopToBE": true },

  "ddThrottle": { "enabled": true, "reduceAtPct": 5, "stopAtPct": 10, "minRiskPct": 0.15 },

  "htfFilter": { "enabled": true, "timeframe": "4h", "mode": "emaUp" },

  "minBarsBetweenTrades": 1,
  "cooldownBarsAfterLoss": 2,
  "maxTradesPerDay": 3,

  "reentryATR": 0.30,
  "reentryATRStop": 0.80,
  "reentryATRProfit": 0.50,

  "pyramiding": { "enabled": true, "maxAdds": 3, "riskFracPerAdd": 0.35, "donchianN": 20, "breakATR": 0.25 },

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "statePersistence": { "enable": true, "file": "livestate.json" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
