{
  "mode": "live-paper",
  "reportsDir": "reports-btc-trend",
  "backend": { "type": "ccxt" },
  "exchange": "kraken",
  "symbol": "BTC/USDT",
  "timeframe": "1h",
  "lookback": 1500,

  "startEquity": 20000,
  "riskPerTradePct": 0.6,
  "maxPositionNotionalUSD": 15000,
  "feesPctRoundtrip": 0.08,
  "slippageBps": 2,

  "rsiPeriod": 14,
  "emaFast": 50,
  "emaSlow": 200,
  "atrPeriod": 21,
  "atrStopMult": 2.4,

  "strategy": { "style": "trend" },

  "rsiLong": 52,
  "rsiLongSoft": 48,
  "useLtfEmaSlope": true,
  "entryAtrCushion": 0.15,

  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 0.8 },

  "trailingStop": { "enabled": true, "mode": "entryATR", "atrMult": 2.6, "percent": 4, "onCloseOnly": true },
  "trailStartR": 1.2,

  "htfFilter": { "enabled": true, "timeframe": "4h", "mode": "emaUpOrRsi", "rsiAbove": 52, "confirmLag": 0, "minBars": 300 },

  "minBarsBetweenTrades": 2,
  "cooldownBarsAfterLoss": 2,

  "reentryATR": 0.30,
  "reentryATRStop": 0.60,
  "reentryATRProfit": 0.30,

  "maxTradesPerDay": 6,
  "maxConsecutiveLosses": 4,
  "minHoldBars": 2,
  "dailyLossLimitPct": 1.2,
  "lossStreakDecayPerDay": 1,

  "volFilter": { "enabled": true, "atrPctMin": 0.35, "atrPctMax": 8.0 },
  "timeStop": { "enabled": true, "bars": 96 },
  "partialTake": { "enabled": true, "atR": 1.0, "closeFrac": 0.5, "moveStopToBE": true },
  "ddThrottle": { "enabled": true, "reduceAtPct": 6, "stopAtPct": 12, "minRiskPct": 0.2 },

  "pyramiding": { "enabled": true, "maxAdds": 2, "riskFracPerAdd": 0.35, "donchianN": 20, "breakATR": 0.25 },

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "statePersistence": { "enable": true, "file": "livestate.json" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
