{
  "mode": "backtest",
  "reportsDir": "reports-mr",
  "backend": { "type": "alpaca" },
  "alpacaFeed": "iex",

  "timeframe": "1h",
  "lookback": 7000,

  "startEquity": 20000,
  "riskPerTradePct": 0.6,
  "maxPositionNotionalUSD": 20000,
  "feesPctRoundtrip": 0.04,
  "slippageBps": 1,

  "strategy": { "style": "meanReversion" },

  "emaFast": 50,
  "emaSlow": 200,
  "rsiPeriod": 14,
  "atrPeriod": 21,

  "rsiOversold": 45,
  "rsiExit": 56,


  "atrStopMult": 2.0,
  "trailingStop": { "enabled": true, "mode": "barATR", "atrMult": 2.2, "onCloseOnly": true },
  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 0.25 },

  "htfFilter": { "enabled": false },

  "entryAtrCushion": 0,
  "minBarsBetweenTrades": 1,
  "cooldownBarsAfterLoss": 2,
  "maxTradesPerDay": 5,

  "reentryATR": 0.20,
  "reentryATRStop": 0.50,
  "reentryATRProfit": 0.25,

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
