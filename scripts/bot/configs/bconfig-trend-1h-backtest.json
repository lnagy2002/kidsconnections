{
  "mode": "backtest",
  "reportsDir": "reports-trend",
  "backend": { "type": "alpaca" },
  "alpacaFeed": "iex",

  "timeframe": "1d",
  "lookback": 1500,

  "startEquity": 20000,
  "riskPerTradePct": 0.6,
  "maxPositionNotionalUSD": 15000,
  "feesPctRoundtrip": 0.04,
  "slippageBps": 1,

  "strategy": { "style": "trend" },

  "emaFast": 50,
  "emaSlow": 200,
  "rsiPeriod": 14,
  "atrPeriod": 21,

  "rsiLong": 54,
  "rsiLongSoft": 50,
  "useLtfEmaSlope": true,
  "entryAtrCushion": 0.20,

  "atrStopMult": 2.2,
  "trailingStop": { "enabled": true, "mode": "entryATR", "atrMult": 2.6, "onCloseOnly": true },
  "trailStartR": 1.6,
  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 1.0 },

  "htfFilter": { "enabled": false },

  "minBarsBetweenTrades": 2,
  "cooldownBarsAfterLoss": 2,
  "maxTradesPerDay": 1,

  "reentryATR": 0.30,
  "reentryATRStop": 0.80,
  "reentryATRProfit": 0.50,

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
