{
  "mode": "live-paper",
  "reportsDir": "reports-trend-live-conservative",
  "backend": { "type": "alpaca" },
  "alpacaFeed": "iex",

  "timeframe": "1d",
  "lookback": 1500,

  "startEquity": 20000,
  "riskPerTradePct": 0.6,
  "maxPositionNotionalUSD": 15000,
  "feesPctRoundtrip": 0.04,
  "slippageBps": 1,

  "strategy": { "style": "trend" },

  "emaFast": 50,
  "emaSlow": 200,
  "rsiPeriod": 14,
  "atrPeriod": 21,

  "rsiLong": 50,
  "rsiLongSoft": 48,
  "useLtfEmaSlope": true,
  "entryAtrCushion": 0.15,

  "atrStopMult": 2.2,
  "trailingStop": { "enabled":  true, "mode": "entryATR", "atrMult": 2.4, "onCloseOnly": true },
  "trailStartR": 1.3,
  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 0.9 },

  "htfFilter": { "enabled": true, "timeframe": "4h", "mode": "emaUp" },

  "minBarsBetweenTrades": 1,
  "cooldownBarsAfterLoss": 2,
  "maxTradesPerDay": 2,

  "reentryATR": 0.30,
  "reentryATRStop": 0.80,
  "reentryATRProfit": 0.50,

  "pyramiding": { "enabled": true, "maxAdds": 2, "riskFracPerAdd": 0.40, "donchianN": 20, "breakATR": 0.25 },

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "statePersistence": { "enable": true, "file": "livestate.json" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
