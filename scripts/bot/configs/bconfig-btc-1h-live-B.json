{
  "mode": "live-paper",
  "reportsDir": "reports-btc-live-B",
  "backend": { "type": "ccxt" },
  "exchange": "kraken",
  "symbol": "BTC/USDT",
  "timeframe": "1h",
  "lookback": 1200,

  "startEquity": 20000,
  "riskPerTradePct": 0.25,
  "maxPositionNotionalUSD": 12000,
  "feesPctRoundtrip": 0.08,
  "slippageBps": 2,

  "rsiPeriod": 14,
  "emaFast": 50,
  "emaSlow": 200,
  "atrPeriod": 21,
  "atrStopMult": 2.8,

  "strategy": { "style": "trend" },

  "rsiLong": 48,
  "rsiLongSoft": 44,
  "useLtfEmaSlope": true,

  "momentumExit": { "enabled": true, "requiresProfit": true, "minR": 0.50 },

  "trailingStop": {
    "enabled": true,
    "mode": "entryATR",
    "atrMult": 2.6,
    "percent": 4,
    "onCloseOnly": true
  },
  "trailStartR": 1.0,

  "htfFilter": {
    "enabled": true,
    "timeframe": "4h",
    "mode": "emaUpOrRsi",
    "rsiAbove": 49,
    "confirmLag": 1,
    "minBars": 400
  },

  "trendLtfConfirm": false,
  "minBarsBetweenTrades": 5,
  "cooldownBarsAfterLoss": 3,

  "reentryATR": 0.50,
  "reentryATRStop": 0.90,
  "reentryATRProfit": 0.40,

  "maxTradesPerDay": 4,
  "maxConsecutiveLosses": 4,
  "minHoldBars": 2,
  "dailyLossLimitPct": 0.8,
  "lossStreakDecayPerDay": 1,

  "csv": { "enable": true, "trades": "trades.csv", "equity": "equity.csv" },
  "statePersistence": { "enable": true, "file": "livestate.json" },
  "enterExecLog": { "enable": true, "file": "enter-exec.csv" },
  "debugSignals": true,
  "debugToFile": true,
  "pollSeconds": 60
}
